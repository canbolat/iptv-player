{
  "name": "iptv-player",
  "version": "0.3.0",
  "description": "Electron + React IPTV oynatıcı",
  "main": "./out/main/index.js",
  "author": "IPTV Player",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
